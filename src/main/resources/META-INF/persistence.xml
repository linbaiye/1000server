<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee"
             xmlns:xsi="http://w3.org"
             xsi:schemaLocation="https://jakarta.ee
                                 https://jakarta.ee/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="org.y1000" transaction-type="RESOURCE_LOCAL">

        <class>org.y1000.account.Account</class>
        <class>org.y1000.persistence.BankPo</class>
        <class>org.y1000.persistence.EquipmentPo</class>
        <class>org.y1000.persistence.GuildPo</class>
        <class>org.y1000.persistence.GuildKungFuPo</class>
        <class>org.y1000.persistence.GuildMembershipPo</class>
        <class>org.y1000.persistence.InventoryPo</class>
        <class>org.y1000.persistence.KungFuBookPo</class>
        <class>org.y1000.persistence.PlayerPo</class>

        <properties>
            <!--property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/y1000" /-->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://127.0.0.1:5432/y1000" />
            <property name="jakarta.persistence.jdbc.user" value="test" />
            <property name="jakarta.persistence.jdbc.password" value="test" />

            <property name="hibernate.physical_naming_strategy" value="org.y1000.persistence.NamingStrategy" />

            <property name="hibernate.hikari.minimumIdle" value="5" />
            <property name="hibernate.hikari.maximumPoolSize" value="10" />
            <property name="hibernate.hikari.idleTimeout" value="30000" />
            <property name="hibernate.connection.provider_class" value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider" />

        </properties>
    </persistence-unit>
    <persistence-unit name="org.y1000.test" transaction-type="RESOURCE_LOCAL">

        <class>org.y1000.account.Account</class>
        <class>org.y1000.persistence.BankPo</class>
        <class>org.y1000.persistence.EquipmentPo</class>
        <class>org.y1000.persistence.GuildPo</class>
        <class>org.y1000.persistence.GuildKungFuPo</class>
        <class>org.y1000.persistence.GuildMembershipPo</class>
        <class>org.y1000.persistence.InventoryPo</class>
        <class>org.y1000.persistence.KungFuBookPo</class>
        <class>org.y1000.persistence.PlayerPo</class>

        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:db1;DB_CLOSE_DELAY=-1" />
            <property name="jakarta.persistence.jdbc.user" value="sa" />
            <property name="jakarta.persistence.jdbc.password" value="" />

            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create" />

            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
            <property name="hibernate.highlight_sql" value="true" />
            <property name="hibernate.physical_naming_strategy" value="org.y1000.persistence.NamingStrategy" />
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect" />
        </properties>
    </persistence-unit>
</persistence>